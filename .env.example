# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Airtable (server-side only, set these in Vercel Environment Variables) ---
# Personal Access Token with `data.records:read` scope (never expose to the browser).
# NEVER paste a real token into this file or commit it to the repository.
AIRTABLE_TOKEN="pat_YOUR_PERSONAL_ACCESS_TOKEN"
# Base ID from the Airtable API docs page (starts with `app`).
AIRTABLE_BASE_ID="appCxDAZHPIW8aJfG"
# Table name or table ID that holds the catalog.
AIRTABLE_TABLE="tblsRr5AgSfxMJX5o"
# Optional: only read records from a specific view.
AIRTABLE_VIEW="viw6lFtvC944S8Y27"

# --- Password gate for the /add-product page (server-side only, set in Vercel) ---
ADD_PRODUCT_PASSWORD="choose-a-strong-password"
# Optional secret used to sign the unlock token (defaults to the password if unset).
# ADD_PRODUCT_SECRET="a-long-random-string"
